{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "chemventure-server",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [{ "name": "ChemRoom", "class_name": "ChemRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChemRoom"] }],
  "observability": { "enabled": true }
}
